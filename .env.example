# 複製成 .env 後依目標電腦修改；不要提交 .env。
# Copy to .env and edit for the target machine; never commit .env.
# 路徑可為絕對路徑或使用 $HOME。This file is sourced by Bash.

# 共用 SLAM 工具鏈 / Shared SLAM toolchain.
KACHAKA_TOOLS_DIR=/opt/kachaka/fungi

# kachaka_api Python package 所在目錄 / Package directory.
KACHAKA_API_PATH=/opt/kachaka/kachaka-api/python

# 能 import kachaka_api 與 requirements 的 Python / Compatible interpreter.
KACHAKA_PYTHON=python3

# 機器人與本機 mapping endpoint / Robot and local mapping endpoints.
KACHAKA_ENDPOINT=KACHAKA_IP:26400
KACHAKA_AI_API_URL=http://localhost:3636

# 可選：含 KACHAKA_IP=... 的檔案 / Optional KACHAKA_IP file.
KACHAKA_ROBOT_ENV_FILE=/opt/kachaka/robotic/.env

# 本機可寫輸出；相對路徑以此 repository 為準 / Local writable outputs.
KACHAKA_OUTPUT_DIR=artifacts/runs
KACHAKA_PREVIEW_DIR=artifacts/previews

# 場地專用 launcher 與 container / Site-specific launchers and containers.
KACHAKA_SLAM_RUNNER=/opt/kachaka/dynamic_SLAM/slam_tools/run_slam_bridge.sh
KACHAKA_T1_RUNNER=/opt/kachaka/dynamic_SLAM/slam_tools/run_t1_server.sh
KACHAKA_SLAM_CONTAINER=gateway_slam
KACHAKA_ARM_CONTAINER=mm_container

# 只供 arm_cam_tune.sh、cam_snap.py 使用 / Camera and host settings.
KACHAKA_CAMERA_SERIAL=YOUR_REALSENSE_SERIAL
KACHAKA_HOST_IP=HOST_IP

# 動態物件遮罩與 slam_tools / Dynamic-object masking and slam_tools (docs/DYNAMIC_MASKING.md)
# SLAM(AI) container 與其中的 server 路徑 / SLAM server container and the server path inside it.
KACHAKA_AI_CONTAINER=slam_node
KACHAKA_SERVER_DIR_CT=/workspace/ma-long-server
# robot 模式才用 / Kachaka bridge project, robot mode only.
KACHAKA_ROBOTIC_DIR=/opt/kachaka/robotic
# 只有 make_containers.sh 使用 / Used only by slam_tools/make_containers.sh.
KACHAKA_AI_IMAGE=slam_node:malong
KACHAKA_GATEWAY_IMAGE=gateway_slam_node:dev
# 同時放 ma-long-server/ 與 dynamic_SLAM/ 的主機資料夾，及其在 container 內的路徑。
# Host folder holding ma-long-server/ and dynamic_SLAM/, and where it is mounted in the container.
KACHAKA_CODE_DIR=/opt/kachaka/code
KACHAKA_CODE_DIR_CT=/workspace
# 含 src/weights 與 vendor/weights 的 ma-long 目錄 / ma-long tree with src/weights and vendor/weights.
KACHAKA_WEIGHTS_DIR=/opt/kachaka/fungi/semantic_slam/src/ma-long
# 本流程不動手臂時設 1：手臂節點未啟動只警告 / 1 = arm node missing is only a warning (mapping never moves the arm).
KACHAKA_ARM_OPTIONAL=0

# SLAM server options (read by slam_tools/run_t1_server.sh; see docs/DYNAMIC_MASKING.md)
# SEMANTIC=1                    # semantic instances + deploy files (alignment, nav bundle); ~20 GB more GPU memory
# DYNAMIC_GEO_GATE=anchor       # none = motion channel alone can remove
# DYNAMIC_PERSON_DILATE_PX=5    # 0 = off
# DYNAMIC_PERSON_BOX_FILL=1     # 0 = off
# DYNAMIC_BOX_FILL_DOWN=0.6     # 0 = off
# DYNAMIC_BRIDGE_MAX_GAP=3      # 1 = single-frame bridge (before 2026-10-01)
# DYNAMIC_EDGE_RING_PX=12       # 0 = off
# DYNAMIC_CARVE=1               # 0 = no multi-view carving
# DYNAMIC_CARRIED_RULE=touch   # touch_and_moving_or_held = remove an object beside a person only if moving or held
